<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-free, RELOADABLE logic: the key-graph navigation engine (ported from wotr-access), the
    navigator, the input category model, the screen stack, the type-ahead search, and the authored
    strings table. References Contracts only (no Unity, no BepInEx) so it stays unit-testable off-engine.
    The host loads this assembly INTO the module's collectible load context (never into the default
    context), so a change here hot-reloads with the module. Anything the host must hold belongs in
    Contracts, not here.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>GuildrunAccess.Core</AssemblyName>
    <RootNamespace>GuildrunAccess.Core</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuildrunAccess.Contracts\GuildrunAccess.Contracts.csproj" />
  </ItemGroup>

</Project>
